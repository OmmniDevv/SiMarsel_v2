// SIMMARSEL TASKLIST — ERD TO-BE v1.0 (REVIEW SA/BE)
// Logical design; BUKAN hasil introspeksi database fisik atau migration yang sudah diterapkan.
// Baseline: ERP existing TASK-01–11, kebutuhan TASK-12–19.
// PENDING: lokasi penyimpanan catatan kerja individual PIC dan representasi scope divisi Supervisor.
// Tabel baru/field tambahan bersifat rancangan hingga diaudit terhadap database dan migration existing.
//
// Salinan ERD acuan PR #115 (17 Nov 2026). Kecocokan skema fisik diuji otomatis di
// tests/Feature/Database/TasklistErdConformanceTest.php.

Project SimMarsel_Tasklist_ToBe {
  database_type: 'MySQL'
  Note: 'Banyak PIC aktif per task tanpa Lead PIC; Manager lintas divisi; Supervisor sesuai divisi yang dikelola; Admin sesuai permission pemeliharaan; seluruh akun aktif memiliki akses baca global. Aturan perubahan data diperiksa Backend. Tidak melarang self-approval Manajer/Supervisor yang berwenang.'
}

// ========== MASTER DATA DAN PERMISSION ==========
Table roles {
  id bigint [pk, increment]
  code_role varchar(25) [not null, unique, note: 'Existing ADM, MGR, EMP (Staff); usulan SPV dan FRL. Verifikasi kode terhadap existing.']
  name varchar(50) [not null]
  created_at timestamp
  updated_at timestamp
}

// Tabel permission dibuat/disesuaikan hanya jika mekanisme RBAC existing belum cukup.
Table permissions {
  id bigint [pk, increment]
  code varchar(80) [not null, unique, note: 'Contoh: task.view_all, task.create, task.update, task.delete, task.assign, task.review, task.change_status. Scope divisi dan ownership diperiksa Backend.']
  description text
  created_at timestamp
  updated_at timestamp
}

Table role_permissions {
  role_id bigint [not null]
  permission_id bigint [not null]
  Indexes {
    (role_id, permission_id) [pk]
  }
  Note: 'Role permission saja tidak menggantikan validasi divisi yang dikelola, PIC aktif, status, dan per-field di Backend.'
}

Table divisions {
  id bigint [pk, increment]
  code_division varchar(50) [not null, unique]
  name varchar(100) [not null]
  created_at timestamp
  updated_at timestamp
}

Table accounts {
  id bigint [pk, increment]
  role_id bigint [not null]
  division_id bigint [note: 'Divisi asal akun; tidak membatasi kewenangan lintas divisi Manager. Untuk Supervisor, scope divisi yang dikelola diverifikasi dari relasi/aturan existing.']
  fullname varchar(255) [not null]
  username varchar(255) [not null, unique]
  is_active boolean [not null, default: true, note: 'Usulan; cek apakah indikator aktif sudah disediakan di field lain.']
  created_at timestamp
  updated_at timestamp
  Note: 'Akun existing SimMarsel. Kolom autentikasi lain tidak ditampilkan. Tidak otomatis membuat tabel baru untuk divisi yang dikelola tanpa audit existing.'
}

Table platforms {
  id bigint [pk, increment]
  slug varchar(50) [not null, unique]
  name varchar(100) [not null]
  created_at timestamp
  updated_at timestamp
}

Table task_categories {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  requires_review boolean [not null, default: false]
  evidence_required boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
  Note: 'Relasi default kategori dengan flag per-task harus mengikuti aturan existing; jangan mengubah otomatis saat kategori berubah tanpa requirement.'
}

// ========== TASK UTAMA ==========
Table tasks {
  id bigint [pk, increment]
  title varchar(150) [not null]
  description text [note: 'Instruksi utama task, bukan catatan kerja PIC individual.']
  category_id bigint
  division_id bigint [not null, note: 'Divisi utama/owner task']
  platform_id bigint
  creator_id bigint [note: 'Pertahankan nilai existing saat migration']
  priority varchar(10) [not null, default: 'medium', note: 'low, medium, high, urgent']
  status varchar(20) [not null, default: 'backlog', note: 'Internal codes: backlog, todo, in_progress, ready_review, on_review, done. Migrasikan/mapping status QA lama.']
  start_date date
  deadline date
  requires_review boolean [not null, default: false]
  evidence_required boolean [not null, default: false]
  completed_at timestamp
  version int [not null, default: 1, note: 'Optimistic locking']
  deleted_at timestamp [note: 'Soft delete TASK-13']
  deleted_by bigint
  created_at timestamp
  updated_at timestamp
  Indexes {
    (division_id, status)
    (status, deadline)
    start_date
    deleted_at
  }
  Note: 'Penugasan PIC disimpan di task_assignments. tasks.is_shared tidak diperlukan untuk global read. Catatan kerja per PIC perlu dipetakan dari schema existing atau dirancang tersendiri sebelum implementasi TASK-13.'
}

// Hanya apabila perlu divisi kolaborator independen dari assignment PIC.
Table task_divisions {
  task_id bigint [not null]
  division_id bigint [not null]
  added_by bigint
  created_at timestamp
  Indexes {
    (task_id, division_id) [pk]
  }
  Note: 'Divisi kolaborator, bukan otomatis semua divisi asal PIC. Jangan mengulang divisi utama tasks.division_id.'
}

Table task_assignments {
  id bigint [pk, increment]
  task_id bigint [not null]
  account_id bigint [not null, note: 'PIC aktif bila unassigned_at IS NULL']
  assigned_by bigint
  assigned_at timestamp [not null]
  unassigned_by bigint
  unassigned_at timestamp
  note text [note: 'Catatan assignment; belum otomatis berarti catatan progres individual PIC.']
  active_flag tinyint
  Indexes {
    (task_id, account_id, active_flag) [unique, name: 'task_assignments_active_pic_unique']
    (task_id, unassigned_at)
    (account_id, unassigned_at)
  }
  Note: 'Banyak PIC aktif; tidak ada Lead PIC/konfirmasi PIC individual. Riwayat assignment tidak dihapus saat reassign. Generated column active_flag dan unique index mencegah akun yang sama menjadi PIC aktif dua kali pada task yang sama. PIC dapat memindahkan shared status sampai Ready Review menurut TASK-17.'
}

// ========== EVIDENCE, REVIEW, KOMENTAR ==========
Table task_evidences {
  id bigint [pk, increment]
  task_id bigint [not null]
  submitter_id bigint [note: 'Nullable untuk kompatibilitas data legacy jika owner tidak diketahui; upload baru wajib mencatat submitter terautentikasi.']
  type varchar(10) [not null, note: 'file atau link; dokumen/gambar dibedakan dari mime_type']
  file_path varchar(255)
  file_name varchar(255)
  mime_type varchar(100)
  file_size bigint
  url text
  note text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  deleted_by bigint
  Indexes {
    (task_id, created_at)
  }
  Note: 'Pertahankan task_evidences existing. Storage privat. PIC aktif hanya boleh hapus evidence miliknya berdasarkan submitter_id + permission; Soft delete/audit mempertahankan histori. Status Done readonly jika ketentuan tersebut difinalkan pada TASK-18.'
}

Table task_reviews {
  id bigint [pk, increment]
  task_id bigint [not null]
  reviewer_id bigint
  decision varchar(30) [not null, note: 'Contoh DB: approved/revision_requested; cocokkan dengan nilai API existing (mis. request_revision).']
  note text [note: 'Alasan formal wajib jika keputusan adalah Request Revision (validasi Backend).']
  created_at timestamp
  updated_at timestamp
  Indexes {
    (task_id, created_at)
  }
  Note: 'Setiap keputusan review baris baru agar siklus lama tidak tertimpa. Tidak boleh ada constraint reviewer_id != PIC; self-approval Manager/Supervisor diperbolehkan jika permission valid. Comment Only terpisah dari review formal.'
}

Table task_comments {
  id bigint [pk, increment]
  task_id bigint [not null]
  author_id bigint [not null]
  parent_comment_id bigint [note: 'NULL = komentar utama; reply harus berasal dari task yang sama']
  content text [not null]
  created_at timestamp [not null]
  updated_at timestamp
  deleted_at timestamp [note: 'Opsional; hanya dipakai jika fitur delete comment disetujui.']
  Indexes {
    (task_id, created_at)
    parent_comment_id
  }
  Note: 'Komentar opsional, tidak mengubah status/task_review. Input diperbolehkan pada status aktif sesuai TASK-16; setelah Done read-only. Parent task yang sama divalidasi Backend.'
}

// ========== RIWAYAT DAN KALENDER ==========
Table task_activities {
  id bigint [pk, increment]
  task_id bigint [not null]
  account_id bigint [note: 'Pelaku; null hanya bila sesuai kebijakan pemeliharaan histori akun legacy.']
  action varchar(50) [not null, note: 'created, updated, deleted, assigned, unassigned, status_changed, reviewed, revision_requested, evidence_added, evidence_deleted, comment_added, dll.']
  changes json [note: 'Perubahan before/after dan metadata relevan']
  created_at timestamp [not null]
  Indexes {
    (task_id, created_at)
  }
  Note: 'Append-only; task, assignment, review, evidence, dan comments tetap dapat diaudit setelah task direvisi atau dihapus secara logis.'
}

// Hanya jika model agenda existing belum memenuhi kebutuhan Calendar TASK-11/TASK-15.
Table calendar_events {
  id bigint [pk, increment]
  division_id bigint [note: 'Divisi penyelenggara; NULL untuk agenda umum perusahaan']
  creator_id bigint [not null]
  title varchar(255) [not null]
  description text
  start_at datetime [not null]
  end_at datetime
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Indexes {
    start_at
  }
  Note: 'Agenda independen. Calendar juga membaca tasks.start_date/deadline tanpa menyalin task menjadi event. Aturan akses agenda harus direkonsiliasi dengan Schedule/Calendar existing.'
}

// ========== RELASI ==========
Ref: accounts.role_id > roles.id
Ref: accounts.division_id > divisions.id
Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id
Ref: tasks.category_id > task_categories.id
Ref: tasks.division_id > divisions.id
Ref: tasks.platform_id > platforms.id
Ref: tasks.creator_id > accounts.id
Ref: tasks.deleted_by > accounts.id
Ref: task_divisions.task_id > tasks.id
Ref: task_divisions.division_id > divisions.id
Ref: task_divisions.added_by > accounts.id
Ref: task_assignments.task_id > tasks.id
Ref: task_assignments.account_id > accounts.id
Ref: task_assignments.assigned_by > accounts.id
Ref: task_assignments.unassigned_by > accounts.id
Ref: task_evidences.task_id > tasks.id
Ref: task_evidences.submitter_id > accounts.id
Ref: task_evidences.deleted_by > accounts.id
Ref: task_reviews.task_id > tasks.id
Ref: task_reviews.reviewer_id > accounts.id
Ref: task_comments.task_id > tasks.id
Ref: task_comments.author_id > accounts.id
Ref: task_comments.parent_comment_id > task_comments.id
Ref: task_activities.task_id > tasks.id
Ref: task_activities.account_id > accounts.id
Ref: calendar_events.division_id > divisions.id
Ref: calendar_events.creator_id > accounts.id
