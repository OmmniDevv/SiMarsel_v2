        "transactions": {
            "platform_id": { "type": "integer", "nullable": false, "meaning": "Platform pemilik transaksi. Bagian dari key transaksi." },
            "markaz_transaction_id": { "type": "string", "nullable": false, "meaning": "ID transaksi dari Markaz. Key transaksi adalah (platform_id, markaz_transaction_id)." },
            "markaz_ref_id": { "type": "string", "nullable": true, "meaning": "ref_id dari API. Terisi berarti baris anggota grup; nilainya markaz_transaction_id baris pembeli pada platform_id yang sama." },
            "markaz_customer_id": { "type": "integer", "nullable": false, "meaning": "ID akun pembayar di Markaz. Identitas Pembeli Unik adalah (platform_id, markaz_customer_id)." },
            "markaz_created_at": { "type": "datetime", "nullable": false, "meaning": "Waktu transaksi dibuat di Markaz. Dasar tanggal untuk Total, Konversi, dan rincian status." },
            "markaz_paid_at": { "type": "datetime", "nullable": true, "meaning": "Nilai paid_date terbaru dari API apa adanya. Kosong jika Markaz belum mengirim tanggal bayar." },
            "paid_date": { "type": "date", "nullable": true, "meaning": "Tanggal bayar valid terakhir untuk laporan. Dasar tanggal untuk metrik pembayaran." },
            "paid_time": { "type": "time", "nullable": true, "meaning": "Jam bayar valid terakhir untuk laporan, pasangan paid_date." },
            "synced_at": { "type": "datetime", "nullable": false, "meaning": "Waktu SiMarsel terakhir mengambil transaksi ini. Tidak pernah dipakai sebagai tanggal kejadian." },
            "source_status": { "type": "status", "nullable": true, "meaning": "Field status dari API Markaz." },
            "effective_status": { "type": "status", "nullable": true, "meaning": "Status yang menggantikan source_status untuk laporan jika terisi, termasuk nilai 0." },
            "is_claim_coupon": { "type": "boolean", "nullable": false, "meaning": "Checkout klaim kupon. Masuk Total, keluar dari pembilang dan penyebut Konversi." },
            "product_price": { "type": "money", "nullable": false, "meaning": "Harga paket setelah diskon paket." },
            "voucher_discount": { "type": "money", "nullable": false, "meaning": "Potongan voucher." },
            "admin_fee": { "type": "money", "nullable": false, "meaning": "Biaya admin." },
            "nominal": { "type": "money", "nullable": false, "meaning": "Tagihan. Dipakai kolom Nominal daftar dan rincian nominal status." },
            "net_nominal": { "type": "money", "nullable": false, "meaning": "Dasar kontribusi omzet." }
        },
        "coverage": {
            "platform_id": { "type": "integer", "nullable": false, "meaning": "Platform yang dicakup." },
            "dataset": { "type": "dataset", "nullable": false, "meaning": "transactions atau downloaders." },
            "date_from": { "type": "date", "nullable": false, "meaning": "Awal periode yang dihitung." },
            "date_to": { "type": "date", "nullable": false, "meaning": "Akhir periode yang dihitung (inklusif)." },
            "complete_until": { "type": "datetime", "nullable": true, "meaning": "Batas atas eksklusif data lengkap. Kosong berarti kelengkapan belum diketahui." },
            "availability": { "type": "availability", "nullable": false, "meaning": "complete, partial, atau unavailable, diturunkan dari complete_until terhadap periode." },
            "sync_finished_at": { "type": "datetime", "nullable": true, "meaning": "Jam job penarikan selesai. Informasi saja, bukan bukti kelengkapan." }
        },
        "dashboard_snapshots": {
            "platform_id": { "type": "integer", "nullable": false, "meaning": "Platform pemilik catatan." },
            "dataset": { "type": "dataset", "nullable": false, "meaning": "Dataset yang direkap." },
            "date_from": { "type": "date", "nullable": false, "meaning": "Awal periode rekap." },
            "date_to": { "type": "date", "nullable": false, "meaning": "Akhir periode rekap (inklusif)." },
            "cutoff_at": { "type": "datetime", "nullable": false, "meaning": "Jam rekap. Data yang direkap adalah kejadian sebelum jam ini." },
            "is_complete": { "type": "boolean", "nullable": false, "meaning": "true jika data platform dan dataset ini lengkap sampai cutoff_at saat direkam." },
            "payload": { "type": "object", "nullable": false, "meaning": "Angka hasil rekap pada cutoff_at." },
            "recorded_at": { "type": "datetime", "nullable": false, "meaning": "Waktu catatan disimpan. Bukan jam rekap." }
        }
    },
